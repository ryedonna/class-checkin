# Copy to .env.local for local dev. On Vercel, add these under Project Settings -> Environment Variables.
# Server-side only: never exposed to the browser.

# The Apps Script web app URL (ends with /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Must match SECRET_TOKEN in apps-script/Code.gs
SCRIPT_TOKEN=change-this-to-a-long-random-string
